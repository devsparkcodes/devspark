# Contact form — email delivery through the Resend HTTP API.
#
# The contact-form variables below are SERVER-SIDE ONLY. Never prefix any
# of them with NEXT_PUBLIC_ and never commit real values: they belong in
# the deployment platform's environment settings (e.g. Vercel → Project →
# Settings → Environment Variables), not in this file. One PUBLIC
# build-time variable (NEXT_PUBLIC_SITE_URL) is documented separately at
# the bottom of this file.
#
# The contact form posts to /api/contact, which validates the submission,
# applies rate limiting, and forwards accepted messages to Resend. While
# the required variables below are missing, submissions are honestly
# rejected with a clear 503 notice — a success message is never shown
# without a confirmed provider acceptance.
#
# ─────────────────────────────────────────────────────────────────────
# Manual setup required before real delivery works
# ─────────────────────────────────────────────────────────────────────
# No credentials exist in this repository and none were created for it.
# To enable real delivery:
#
#   1. Create a Resend account at https://resend.com — ideally using the
#      DevSpark inbox (devspark.codes@gmail.com) as the account address,
#      because Resend's test mode only delivers to the account owner's
#      own address.
#   2. Create an API key (Dashboard → Developers → API Keys). It starts
#      with "re_".
#   3. Choose a sender (see CONTACT_FROM_EMAIL below):
#        a) Fastest, test mode only: "DevSpark <onboarding@resend.dev>".
#           Delivers only to the Resend account's own address — which,
#           with the setup above, IS the DevSpark inbox.
#        b) Real sender for arbitrary recipients: a domain you control,
#           verified in Resend with SPF, DKIM and DMARC DNS records.
#           A Gmail address CANNOT be verified as a Resend sending
#           domain — do not attempt to use one.
#   4. Set the three required variables below and submit the contact form
#      once. Confirm arrival in the Resend dashboard (Logs) and in the
#      inbox.
#
# ─────────────────────────────────────────────────────────────────────

# Required. API key from the Resend dashboard (starts with "re_"). Used
# only in the server-side route handler.
RESEND_API_KEY=

# Required. Verified sender, in the form "Name <address>".
# Test mode:    "DevSpark <onboarding@resend.dev>"
# Verified domain: "DevSpark <hello@your-verified-domain.com>"
CONTACT_FROM_EMAIL=

# Optional. Destination inbox for all form submissions. Defaults to the
# published site address (devspark.codes@gmail.com) when unset, so the
# published contact and the form destination cannot drift apart. Set this
# only to override the destination.
CONTACT_TO_EMAIL=

# Optional, testing only. Overrides the Resend API endpoint so a local
# mock provider can be used during development. Leave unset in
# production — unset means the real endpoint
# (https://api.resend.com/emails) is used.
RESEND_API_URL=

# ─────────────────────────────────────────────────────────────────────
# Public site URL — SEO (canonical, Open Graph, sitemap, robots)
# ─────────────────────────────────────────────────────────────────────
# This is the ONE public build-time variable (NEXT_PUBLIC_ prefix). Its
# value is baked into the built HTML, so it must never contain secrets —
# only the deployed origin.
#
# Set it AFTER the first deployment to the real origin, with no trailing
# slash, e.g.:
#   NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
# (use the actual hostname Vercel assigns — do not guess it in advance.)
#
# While unset, canonical/Open Graph tags and the sitemap are simply
# omitted: the site never advertises localhost or an invented domain,
# and it stays fully indexable either way. After setting it, redeploy
# for the SEO tags to appear.
NEXT_PUBLIC_SITE_URL=
